{
  "expo": {
    "name": "HarmonyLab",
    "slug": "harmonylab",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/harmonylab-app-icon.png",
    "scheme": "harmonylab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "2",
      "bundleIdentifier": "com.harmonylab.mobile",
      "icon": "./assets/images/harmonylab-app-icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/harmonylab-adaptive-icon.png"
      },
      "package": "com.harmonylab.mobile",
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf6ed",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b954eb3e-09fa-4c85-b888-ad69f8c0a899"
      }
    },
    "owner": "marsromulo"
  }
}
